{
  "name": "yaam-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:postgresql": "node server.postgresql.js",
    "check:env": "node scripts/check-env.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migration-status.js",
    "seed": "node db/seed.js",
    "seed:postgresql": "node db/postgresql/seed.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "test": "node --test test/*.test.js",
    "test:postgresql": "NODE_ENV=test node --test test/postgresql/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^1.1.2",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17"
  }
}
