# YAAM — production ENV шаблон для PostgreSQL-стороны (server.postgresql.js).
#
# Production Switch — Stage 9. ЭТОТ ФАЙЛ — ШАБЛОН, ПОДГОТОВЛЕННЫЙ БЕЗ
# ДОСТУПА К РЕАЛЬНОМУ VPS. Ни одно значение здесь не проверено против
# реальной инфраструктуры — заполните и адаптируйте под конкретный сервер,
# затем скопируйте как /opt/yaam/server/.env.postgresql (см.
# server/docs/postgresql-deployment-runbook.md).
#
# НЕ ПУТАТЬ с server/.env.example — тот для SQLite-стороны (server.js),
# который остаётся ЕДИНСТВЕННЫМ реально работающим production-путём на
# сегодня (yaam.su). Этот файл — для будущего server.postgresql.js
# (изолирован, никогда не запускается автоматически).

# --- Приложение -------------------------------------------------------

# local | staging | production
APP_ENV=production

# production включает: (а) запрет dev-платёжных маршрутов, (б) обязательный
# TRUST_PROXY=loopback (см. ниже), (в) generic-сообщения об ошибках без
# stack trace клиенту, (г) NODE_ENV=production также отключает localhost в
# CORS-allowlist (config/cors.js).
NODE_ENV=production

PG_HEALTH_PORT=3001
PG_HEALTH_HOST=127.0.0.1

# --- PostgreSQL (production database) ----------------------------------
#
# Отдельная production БД, отдельный пользователь с МИНИМАЛЬНЫМИ правами
# (см. postgresql-deployment-runbook.md, раздел "PostgreSQL setup") — НЕ
# суперпользователь, НЕ владелец кластера. Пример (заполнить реальными
# значениями):
#   DATABASE_URL=postgres://yaam_app:СЛОЖНЫЙ_ПАРОЛЬ@127.0.0.1:5432/yaam_production
#
# Альтернатива — дискретные переменные вместо DATABASE_URL (db/postgresql/
# bootstrap.js validateEnv() принимает любой из двух вариантов):
DATABASE_URL=
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=yaam_production
# PGUSER=yaam_app
# PGPASSWORD=

# PostgreSQL слушает только на loopback (см. runbook) — TLS между
# приложением и локальным PostgreSQL на том же хосте избыточен; если
# PostgreSQL когда-либо переедет на отдельный хост — обязательно true.
PG_SSL=false

# Пул подключений — дефолты (db/postgresql/index.js) обычно достаточны для
# одного backend-процесса; трогать только по реальным метрикам нагрузки.
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECT_TIMEOUT_MS=5000

# --- CORS ----------------------------------------------------------------

# Через запятую. Если не задано — дефолт https://yaam.su,https://www.yaam.su
# (см. config/cors.js) — обычно достаточно, оставить пустым.
CORS_ALLOWED_ORIGINS=

# --- Trust proxy (Production Switch Stage 9) ------------------------------
#
# ОБЯЗАТЕЛЬНО "loopback" при APP_ENV=production — иначе приложение
# откажется стартовать (fail-closed, services/postgresql/app.js
# validateAppEnv()). Единственная поддерживаемая топология — один Nginx на
# том же VPS перед одним backend-процессом (не CDN/несколько прокси в
# цепочке — тогда потребуется отдельный пересмотр, не просто "true").
#
# ПЕРЕД включением YOOKASSA_WEBHOOK_ENFORCE_IP_ALLOWLIST (ниже) — ОБЯЗАТЕЛЬНО
# подтвердить на реальном сервере, что Nginx корректно передаёт
# X-Forwarded-For и что req.ip в приложении отражает реальный внешний IP,
# а не адрес Nginx (см. runbook, раздел "Trust Proxy validation").
TRUST_PROXY=loopback

# --- Платежи (ЮKassa) ------------------------------------------------------

# disabled (production foundation: каталог/HQ доступны, оформление 503) |
# mock (только demo/staging, запрещён в production) | yookassa
PAYMENT_PROVIDER=disabled

# Заполнить ТОЛЬКО тестовыми credentials. Провайдер и startup validation
# намеренно fail-closed: без sandbox/test_ значений приложение не запустится.
YOOKASSA_ENV=sandbox
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://yaam.su/
YOOKASSA_WEBHOOK_URL=https://api-pg.yaam.su/api/webhooks/payment

# Официальный IP-allowlist ЮKassa (Stage 8, services/paymentProviders/
# yookassaProvider.js) — ВЫКЛЮЧЕНО по умолчанию намеренно. Включать true
# ТОЛЬКО после того, как runbook'ом подтверждено, что TRUST_PROXY=loopback
# выше реально корректно резолвит req.ip на этом сервере (см. предыдущий
# раздел). До этого подтверждения канонический lookup (Stage 8,
# verifyWebhook) остаётся ЕДИНСТВЕННЫМ обязательным механизмом подлинности
# webhook — он не зависит от корректности прокси-цепочки.
YOOKASSA_WEBHOOK_ENFORCE_IP_ALLOWLIST=false

# Только для закрытого mock-staging — при APP_ENV=production маршрут не
# зарегистрируется, даже если здесь ошибочно true (routes/postgresql/api.js,
# тройной гейт: флаг + PAYMENT_PROVIDER=mock + APP_ENV in [local,staging]).
ENABLE_DEV_PAYMENT_ROUTES=false

# Таймауты сетевых вызовов провайдера, мс (опционально, дефолт 10000 у всех).
# PAYMENT_CREATE_TIMEOUT_MS=10000
# PAYMENT_STATUS_TIMEOUT_MS=10000
# PAYMENT_REFUND_TIMEOUT_MS=10000
# PAYMENT_GET_REFUND_TIMEOUT_MS=10000

# --- Админка ---------------------------------------------------------------

# Внутренняя админка YAAM (не портал самообслуживания ресторана). Оба
# значения обязательны вместе — иначе /admin вообще не монтируется.
ADMIN_USER=
ADMIN_PASS=

# --- Telegram-бот ресторана -------------------------------------------------

TELEGRAM_BOT_TOKEN=

# --- HQ: фотографии (Stage 5B/5B.2) -----------------------------------------

# Не задан вовсе -> раздел «Фотографии» в HQ отключён, остальной YAAM работает
# как обычно (не ошибка конфигурации сама по себе). Единственный
# поддерживаемый provider — "local": YAAM работает в масштабе одного региона
# (Чечня), фотографии загружает только владелец через HQ — отдельное
# S3-совместимое хранилище на этом масштабе не нужно (см.
# server/docs/persistent-local-media-runbook.md).
# MEDIA_PROVIDER=local

# Постоянная директория на VPS (вне Git-репозитория, вне /tmp) — ОБЯЗАТЕЛЬНА
# в production (APP_ENV=production), иначе приложение не стартует
# (fail-closed: temp-каталог означал бы, что фотографии исчезают при каждом
# restart/deploy). НЕ задавать одновременно с MEDIA_LOCAL_DIR ниже.
# MEDIA_LOCAL_ROOT=/var/lib/yaam/media

# Только для тестов/локальной разработки — явный временный каталог (НЕ
# persistent-режим). Взаимоисключим с MEDIA_LOCAL_ROOT выше.
# MEDIA_LOCAL_DIR=

# Публичный базовый URL, по которому Nginx (production) или Express static
# (dev/test) реально отдают public/-варианты фотографий — например,
# https://api-pg.yaam.su/media (см. runbook, location /media/ в
# server/deploy/nginx-yaam-postgresql.conf). Не покупать отдельный домен —
# поддомен/путь на уже существующем backend-host достаточен.
# MEDIA_LOCAL_BASE_URL=https://api-pg.yaam.su/media

# --- T-Bank T-API (Stage 9.6 — ТОЛЬКО контракт конфигурации, банк ещё НЕ
# подключён) -----------------------------------------------------------------
#
# Ни одна из переменных ниже НЕ читается ни одним модулем приложения на этом
# этапе — это placeholder-документация будущего контракта для Stage 10
# (задание Stage 9.6, раздел 9: "не требовать эти переменные для запуска
# приложения; не создавать T-Bank client; не читать сертификаты"). Приложение
# запускается и полностью работает без единой из этих переменных.
#
# Токен/сертификат/ключ ДОЛЖНЫ храниться вне Git и вне БД — секретный
# менеджер VPS или защищённый .env вне репозитория, права доступа только
# сервисному пользователю (см. T-Bank audit, раздел 18 "Security threat
# model": "Never log the full Authorization header; store the token only in
# a secrets manager / environment variable on the VPS, never in application
# logs or notes fields").

# Базовый URL T-API (T-Bank audit, раздел 4): https://secured-openapi.tbank.ru
# TBANK_API_BASE_URL=

# H2H Access Token — выпускается в личном кабинете T-Business (T-Bank audit,
# раздел 5), НЕ значение по умолчанию, НЕ sandbox-литерал. 90 дней с
# последнего использования, бессрочно при постоянном использовании.
# TBANK_ACCESS_TOKEN=

# mTLS-сертификат (T-Bank audit, раздел 5) — путь к файлам вне веб-корня,
# доступным только сервисному пользователю. Требуется для "защищённых"
# методов (какие именно — UNKNOWN, см. итоговый отчёт T-Bank audit, раздел
# 20, вопрос 7).
# TBANK_CLIENT_CERT_PATH=
# TBANK_CLIENT_KEY_PATH=

# Собственный расчётный счёт YAAM (T-API from.accountNumber) — НЕ дублирует
# TBANK_ACCESS_TOKEN/сертификат: это платёжный реквизит, а не секрет. Начиная
# со Stage 9.6 хранится в БД (таблица yaam_bank_details, HQ Settings), а НЕ
# здесь — эта переменная НЕ нужна и намеренно не добавлена: единственный
# источник истины — БД (singleton-строка), не .env, иначе появилось бы два
# места, которые могут разойтись.

# Bearer/Basic-креды для проверки подлинности webhook (T-Bank audit, раздел
# 8: "Авторизация необязательна. Если она нужна, мы поддерживаем basic и
# bearer авторизацию" — НЕТ криптографической подписи, только IP-allowlist +
# опциональный этот credential). Добавлять ТОЛЬКО вместе с реальным webhook
# endpoint'ом Stage 10 — этот этап endpoint не создаёт (задание, раздел
# "Hard restrictions": "не создавать webhook endpoint").
# TBANK_WEBHOOK_AUTH_SECRET=

# Feature flag для Stage 10 (полностью ВЫКЛЮЧЕН и не читается никаким кодом
# на этом этапе — задание: "не включать его и не создавать runtime-ветку
# отправки"). Когда Stage 10 подключит реальный HTTP-клиент к банку, этот
# флаг должен стать единственным переключателем между "фундамент готов, но
# бездействует" и "реально отправляет деньги".
# TBANK_PAYOUTS_ENABLED=false
