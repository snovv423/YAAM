[Unit]
Description=YAAM hqtest media backup
ConditionPathIsDirectory=/opt/yaam-hqtest/media

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/yaam-media-backup-hqtest
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/yaam-hqtest/media
ReadWritePaths=/var/backups/yaam /run/lock
