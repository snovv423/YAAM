# YAAM — STAGING окружение (Stage 15). ТОЛЬКО ИМЕНА И БЕЗОПАСНЫЕ ПРИМЕРЫ.
# Реальные секреты сюда не попадают и в Git не коммитятся.
#
# Staging — полностью отдельное окружение: своя база, свой бот, свой домен,
# свой session namespace. Доступа к production-данным у него нет и быть не
# должно; копию реальных персональных данных сюда не переносят.

# --- Режим ---------------------------------------------------------------
APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info

# --- Приложение ----------------------------------------------------------
PG_HEALTH_PORT=3002
PG_HEALTH_HOST=127.0.0.1

# --- Публичные URL -------------------------------------------------------
# Обязательны: из них строятся capability-ссылки на документы и return_url
# YooKassa. Домен staging ОТЛИЧАЕТСЯ от production.
PUBLIC_BACKEND_URL=https://api-staging.example.test
PUBLIC_FRONTEND_URL=https://staging.example.test

# --- PostgreSQL ----------------------------------------------------------
# Отдельная база и отдельный пользователь. НЕ production-кластер.
DATABASE_URL=postgres://yaam_staging_app:ЗАМЕНИТЬ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ@127.0.0.1:5432/yaam_staging
PG_SSL=false
PG_POOL_MAX=10

# --- Reverse proxy -------------------------------------------------------
# Конкретное значение, НЕ "true": иначе доверялся бы любой подделанный
# X-Forwarded-For и rate limit можно было бы обойти сменой заголовка.
TRUST_PROXY=loopback
CORS_ALLOWED_ORIGINS=https://staging.example.test

# --- HQ ------------------------------------------------------------------
# Не меньше 32 символов, сгенерирован случайно, НЕ совпадает с production:
# общий секрет означал бы, что cookie staging принимается production.
HQ_SESSION_SECRET=
HQ_ADMIN_USER=
HQ_ADMIN_PASSWORD_HASH=
HQ_LINK_BASE_PATH=
# Маркер в интерфейсе, чтобы staging нельзя было спутать с боевым HQ.
HQ_ENV_LABEL=STAGING

# --- Платежи -------------------------------------------------------------
# Только mock или sandbox. Боевой ключ (live_) в staging отклоняется
# проверкой конфигурации на старте.
PAYMENT_PROVIDER=mock
# При переходе на песочницу:
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_ENV=sandbox
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=test_...
ENABLE_DEV_PAYMENT_ROUTES=false

# --- Telegram ------------------------------------------------------------
# ТЕСТОВЫЙ бот и ТЕСТОВЫЕ группы. Пустое значение = бот не запускается.
# Если токен задан, требуется явное подтверждение — иначе staging разослал бы
# уведомления настоящим ресторанам.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAGING_ACK=

# --- Выплаты -------------------------------------------------------------
PAYOUT_PROVIDER=none

# --- Фискализация --------------------------------------------------------
FISCAL_PROVIDER=none

# --- Демо-данные ---------------------------------------------------------
# В staging демо-данные не заливаются автоматически.
SEED_DEMO_DATA=false

# --- Планировщик ---------------------------------------------------------
# Пустые значения = дефолты приложения.
SCHEDULER_INTERVAL_MS=
ORDER_TIMEOUT_INTERVAL_MS=
WEEKLY_SETTLEMENT_INTERVAL_MS=

# --- Деплой --------------------------------------------------------------
GIT_COMMIT_SHA=
