# YAAM — ENV шаблон для изолированного тестового HQ-окружения hqtest.yaam.su.
#
# ЭТОТ ФАЙЛ — ШАБЛОН, ПОДГОТОВЛЕННЫЙ БЕЗ ДОСТУПА К РЕАЛЬНОМУ VPS. Ни одно
# значение здесь не проверено против реальной инфраструктуры и НЕ содержит
# ни одного настоящего секрета/credential — заполните реальными (но не
# production) значениями и скопируйте как
# /opt/yaam-hqtest/server/.env.hqtest (см. YAAM-HQ-Test-Environment-
# Deployment-Plan.md).
#
# НЕ ПУТАТЬ с server/.env.postgresql.example (api-pg.yaam.su, реальный
# YooKassa Sandbox) — этот файл описывает ПОЛНОСТЬЮ изолированный процесс:
# своя PostgreSQL-база (yaam_hqtest), свой порт (3002), свои HQ-credentials,
# PAYMENT_PROVIDER=mock (без каких-либо платёжных credentials вообще).
# Никогда не копировать значения ИЗ .env.postgresql/.env.production СЮДА.

# --- Приложение -------------------------------------------------------

# production — да, даже для тестового окружения: нужен именно
# APP_ENV=production, чтобы TRUST_PROXY=loopback работал и cookie сессии
# HQ получала флаг Secure (см. services/hq/session.js) — "тестовое" здесь
# относится к ДАННЫМ и ИЗОЛЯЦИИ, не к строгости самого приложения.
APP_ENV=production
NODE_ENV=production

PG_HEALTH_PORT=3002
PG_HEALTH_HOST=127.0.0.1

# --- PostgreSQL (изолированная тестовая база) -----------------------------
#
# ОБЯЗАТЕЛЬНО имя базы РОВНО "yaam_hqtest" — server/db/postgresql/
# seed-hqtest.js технически отказывается работать на любой другой базе (см.
# assertSafeEnvironment() в этом скрипте) — это не просто рекомендация,
# единственная защита seed-скрипта от случайного запуска не на том сервере.
# Отдельная роль с минимальными правами (НЕ суперпользователь), только на
# эту одну базу — тот же принцип, что и для production/staging.
DATABASE_URL=postgres://yaam_hqtest_app:ЗАМЕНИТЬ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ@127.0.0.1:5432/yaam_hqtest
PG_SSL=false

# --- CORS ------------------------------------------------------------------
#
# ОБЯЗАТЕЛЬНО — без этого форма логина HQ будет отклонена общим CORS-
# мидлварем с 403 (собственный Origin формы — https://hqtest.yaam.su, см.
# YAAM-HQ-Stage-2.1-Clean-Root-Routing-Report.md, раздел 10). Только этот
# один origin — НЕ добавлять сюда yaam.su/api-pg.yaam.su (это отдельный,
# полностью изолированный процесс, ему не нужен доступ откуда-либо ещё).
CORS_ALLOWED_ORIGINS=https://hqtest.yaam.su

# --- Trust proxy -------------------------------------------------------
#
# ОБЯЗАТЕЛЬНО "loopback" — за локальным Nginx на том же VPS (см.
# server/deploy/nginx-hqtest.yaam.su.conf, X-Forwarded-Proto/X-Forwarded-For).
# При APP_ENV=production приложение откажется стартовать без этого значения
# (fail-closed, services/postgresql/app.js validateAppEnv()).
TRUST_PROXY=loopback

# --- Платежи -----------------------------------------------------------
#
# ТОЛЬКО mock — это тестовое HQ-окружение, не платёжный стенд. Ни одна
# YooKassa/T-Bank переменная здесь намеренно НЕ указана (даже как пример) —
# они не читаются приложением, пока PAYMENT_PROVIDER≠yookassa, и не нужны
# для тестирования HQ.
PAYMENT_PROVIDER=mock
ENABLE_DEV_PAYMENT_ROUTES=false

# --- HQ: доступ владельца ------------------------------------------------
#
# СВОИ, отдельные от staging/production credentials — сгенерировать заново
# на самой VPS, пароль никогда не должен попасть в историю команд/логи
# локальной машины:
#   cd /opt/yaam-hqtest/server && node scripts/hash-hq-password.js
HQ_ADMIN_USER=
HQ_ADMIN_PASSWORD_HASH=
# openssl rand -hex 32 — СВОЙ, отдельный от staging/production секрет.
HQ_SESSION_SECRET=
# "" (пусто) — clean-root routing, см. services/hq/basePath.js: приложение
# само рендерит "/", "/login" и т.д. без префикса "/hq"; Nginx (см.
# nginx-hqtest.yaam.su.conf) добавляет "/hq" обратно только на пути К
# backend'у. Пустое значение ОБЯЗАТЕЛЬНО присутствует как
# "HQ_LINK_BASE_PATH=" в файле — не отсутствовать вовсе.
HQ_LINK_BASE_PATH=

# --- Тестовая маркировка (см. п.1 задания) --------------------------------
#
# Обязательно задано на hqtest — включает несъёмный баннер «ТЕСТОВЫЙ РЕЖИМ»
# на каждой странице HQ, включая страницу входа (server/hq/layout.js,
# server/routes/hq/auth.js). НИКОГДА не задавать на staging/production —
# отсутствие этой переменной там уже само по себе гарантирует отсутствие
# баннера (fail-safe по умолчанию, не наоборот).
HQ_ENV_LABEL=TEST

# --- Проверка развёрнутого commit (см. п.2 задания) -----------------------
#
# Заполняется ПРИ КАЖДОМ деплое, не вручную один раз — например,
# в деплой-скрипте: GIT_COMMIT_SHA=$(git rev-parse HEAD). Отдаётся в
# GET /health/ready как поле commitSha — способ удалённо (без SSH)
# подтвердить, какой именно commit реально обслуживает hqtest.yaam.su.
# Если не задано — безопасное значение "unknown", не ошибка старта.
GIT_COMMIT_SHA=

# --- Telegram-бот / медиа --------------------------------------------------
#
# Не нужны для тестирования HQ как такового — оставлены пустыми/не заданы.
# Бот не стартует без TELEGRAM_BOT_TOKEN (не ошибка), раздел «Фотографии» в
# HQ покажет «медиа не настроено» без MEDIA_PROVIDER (тоже не ошибка).
TELEGRAM_BOT_TOKEN=
# MEDIA_PROVIDER=

# --- Внутренняя админка (/admin, legacy) -----------------------------------
#
# Не нужна для hqtest — оставить обе переменные пустыми, /admin просто не
# смонтируется (см. services/postgresql/app.js).
ADMIN_USER=
ADMIN_PASS=
